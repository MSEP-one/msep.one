[sub_resource type="ButtonGroup" id="ButtonGroup_imbu4"]

[sub_resource type="GDScript" id="GDScript_w42n7"]
script/source = "# This builtin script works to toggle a pannel visibility by pressing a button
extends Button

@export var panel: PanelContainer


func _ready() -> void:
	assert(panel != null)
	_update_icon()
	pressed.connect(_on_pressed)


func ensure_panel_hidden() -> void:
	panel.visible = false
	_update_icon()


func _on_pressed() -> void:
	panel.visible = not panel.visible
	_update_icon()


func _update_icon() -> void:
	const COLLAPSED_ICON: Texture2D = preload(\"uid://b2w2wxk2bb4wg\")
	const EXPANDED_ICON: Texture2D = preload(\"uid://gl1hqwiod5y0\")
	icon = EXPANDED_ICON if panel.visible else COLLAPSED_ICON
"

